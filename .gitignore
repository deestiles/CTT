# Godot 4+ specific ignores
.godot/
/android/

# Generated builds, logs, editor/OS files, and local credentials
/builds/
/exports/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
.env
.env.*
!.env.example

# Blender recovery files (source .blend files remain versioned)
*.blend1
*.blend2
*.blend@
*.blend~

# Reference map screenshots (third-party imagery; keep local)
maps_v2/reference/*.png
maps_v2/reference/*.jpg
maps_v2/reference/*.jpeg
maps_v2/reference/*.import
